# Homelab nodes resolve by bare name via the pihole resolver on eva01
# (10.14.0.22), which serves the fixed IPs. No HostName overrides needed.
Host eva0*
    User mvaldes
    IdentityFile ~/.ssh/id_ed25519
    CertificateFile ~/.ssh/id_ed25519-cert.pub
    IdentitiesOnly yes

# pi is the one name the resolver does not answer, so it keeps an explicit IP.
Host pi
    User dietpi
    HostName 10.14.0.13

# nas is not a Tailscale node — 10.14 only (reachable remotely via subnet route)
Host nas
    User admin
    HostName 10.14.0.21

# Internal git server
Host git.int.mvaldes.dev
    HostName git.int.mvaldes.dev
    User git
    Port 22
    IdentityFile ~/.ssh/id_ed25519
