{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "theme": "light/dark",
  "hideThinkingBlock": true,
  "quietStartup": true,
  "lastChangelogVersion": "1.5.1",
  "outputPad": 0,
  "collapseChangelog": true,
  "autocompleteMaxVisible": 3,
  "treeFilterMode": "no-tools",
  "markdown": {
    "mermaid": "off"
  },
  "warnings": {
    "anthropicExtraUsage": false
  },
  "otel": {
    "enabled": true,
    "endpoint": "https://events.mvaldes.dev",
    "protocol": "http/protobuf",
    "serviceName": "pi",
    "captureContent": "metadata_only",
    "signals": {
      "traces": true,
      "metrics": true,
      "logs": true
    }
  },
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:@henryqw/pi-herdr",
    "npm:pi-obsidian",
    "npm:pi-web-access",
    "npm:@quintinshaw/pi-dynamic-workflows",
    "npm:pi-caveman",
    "npm:pi-ask-user",
    "npm:pi-otel"
  ],
  "extensions": [
    "-builtin:mcp"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-mcp-adapter\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.87.0",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.47.0"
  }
}